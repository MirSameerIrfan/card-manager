# Copy to .env and fill in. Never commit .env.

# --- Database (Supabase Postgres) -------------------------------------------
# Supabase dashboard -> your project -> Connect. Replace [PASSWORD] with the
# database password (Project Settings -> Database -> Reset database password).
#
# Runtime: the transaction pooler (port 6543), which is safe for serverless.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Migrations (`prisma migrate`): the session pooler (port 5432).
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Per-instance pg pool limits (optional; defaults shown).
# DATABASE_POOL_MAX=5
# DATABASE_POOL_IDLE_TIMEOUT_MS=10000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# --- Auth (better-auth) ------------------------------------------------------
# Full base URL of the app. Required in production.
BETTER_AUTH_URL="http://localhost:3000"
# Required in production. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=""

# --- Email (Resend) ----------------------------------------------------------
# Optional in development: without a key, verification and password reset
# links are printed to the server console instead of being emailed.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MoneyScope <onboarding@resend.dev>"

# --- Sentry (optional) -------------------------------------------------------
# Leave empty to disable error reporting; the app runs normally without it.
SENTRY_DSN=""
VITE_SENTRY_DSN=""
# Build-time only, for uploading source maps.
SENTRY_AUTH_TOKEN=""
