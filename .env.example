# Copy to .env for local development. Never commit .env or .env.production.
#
# Two environments:
#   local       `npm run dev` against a Postgres on this machine (this file).
#   production  Netlify, against Supabase. Its settings live in Netlify's
#               environment variables, not in a file. The only production
#               values kept locally are the Supabase URLs in .env.production,
#               used by `npm run db:migrate:prod` (see the end of this file).

# --- Database (local) ---------------------------------------------------------
# Started by `npm run db:start` (npx prisma dev); the ports are fixed there.
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable"
# Used by `prisma migrate dev` to check migrations against an empty database.
SHADOW_DATABASE_URL="postgres://postgres:postgres@localhost:51215/template1?sslmode=disable"

# Per-instance pg pool limits (optional; defaults shown).
# DATABASE_POOL_MAX=5
# DATABASE_POOL_IDLE_TIMEOUT_MS=10000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=10000

# --- Auth (better-auth) ------------------------------------------------------
# Full base URL of the app. Required in production.
BETTER_AUTH_URL="http://localhost:3000"
# Required in production, with a different value there. Generate with:
# openssl rand -hex 32
BETTER_AUTH_SECRET=""

# --- Email (Resend) ----------------------------------------------------------
# Leave empty locally: verification and password reset links are printed to
# the server console instead of being emailed.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="MoneyScope <onboarding@resend.dev>"

# --- Sentry (optional) -------------------------------------------------------
# Leave empty to disable error reporting; the app runs normally without it.
SENTRY_DSN=""
VITE_SENTRY_DSN=""
# Build-time only, for uploading source maps.
SENTRY_AUTH_TOKEN=""

# --- Production (Netlify environment variables) ------------------------------
# Netlify needs: DATABASE_URL (Supabase transaction pooler, port 6543),
# BETTER_AUTH_URL, BETTER_AUTH_SECRET, RESEND_API_KEY, RESEND_FROM_EMAIL,
# SENTRY_DSN, VITE_SENTRY_DSN and SENTRY_AUTH_TOKEN.
#
# .env.production (gitignored) holds the Supabase URLs for
# `npm run db:migrate:prod`. Supabase dashboard -> your project -> Connect;
# replace [PASSWORD] with the database password.
#   DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
#   DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
